@@ -461,6 +461,30 @@ panvk_per_arch(EndCommandBuffer)(VkCommandBuffer commandBuffer)
    return vk_command_buffer_end(&cmdbuf->vk);
 }
 
+static bool
+panvk_dependency_is_noop(const VkDependencyInfo *dep)
+{
+   const VkPipelineStageFlags2 trivial_stages =
+      VK_PIPELINE_STAGE_2_TOP_OF_PIPE_BIT | VK_PIPELINE_STAGE_2_HOST_BIT;
+
+   for (uint32_t i = 0; i < dep->memoryBarrierCount; i++) {
+      if (dep->pMemoryBarriers[i].srcAccessMask != 0 ||
+          (dep->pMemoryBarriers[i].srcStageMask & ~trivial_stages) != 0)
+         return false;
+   }
+   for (uint32_t i = 0; i < dep->bufferMemoryBarrierCount; i++) {
+      if (dep->pBufferMemoryBarriers[i].srcAccessMask != 0 ||
+          (dep->pBufferMemoryBarriers[i].srcStageMask & ~trivial_stages) != 0)
+         return false;
+   }
+   for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      if (dep->pImageMemoryBarriers[i].srcAccessMask != 0 ||
+          (dep->pImageMemoryBarriers[i].srcStageMask & ~trivial_stages) != 0)
+         return false;
+   }
+   return true;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
                                     const VkDependencyInfo *pDependencyInfo)
@@ -474,6 +498,15 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
     * barrier flag set to true.
     */
    if (cmdbuf->cur_batch) {
+      struct panvk_batch *batch = cmdbuf->cur_batch;
+      if (!batch->fb.desc.gpu && !batch->vtc_jc.first_job &&
+          util_dynarray_num_elements(&batch->event_ops,
+                                     struct panvk_cmd_event_op) == 0)
+         return;
+
+      if (panvk_dependency_is_noop(pDependencyInfo))
+         return;
+
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       panvk_per_arch(cmd_open_batch)(cmdbuf);
    }
