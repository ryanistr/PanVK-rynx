diff --git a/src/panfrost/vulkan/panvk_vX_physical_device.c b/src/panfrost/vulkan/panvk_vX_physical_device.c
index 8efcecf..8dcd909 100644
--- a/src/panfrost/vulkan/panvk_vX_physical_device.c
+++ b/src/panfrost/vulkan/panvk_vX_physical_device.c
@@ -34,6 +34,16 @@
 #define RESERVED_UBO_COUNT                   6
 #define MAX_INLINE_UNIFORM_BLOCK_DESCRIPTORS (32 - RESERVED_UBO_COUNT)
 
+/* The v9 JM path has no geometry/tessellation/XFB implementation: GS binds are
+ * ignored, the XFB variants/sysvals are CSF-only, and the JM compiler does not
+ * handle emit_vertex/end_primitive. PANVK_ADHOC_DXVK=1 restores the legacy
+ * DXVK compatibility advertisement for users who need it. */
+static bool
+panvk_has_gs_tess_xfb(void)
+{
+   return PAN_ARCH >= 10 || getenv("PANVK_ADHOC_DXVK") != NULL;
+}
+
 void
 panvk_per_arch(get_physical_device_extensions)(
    const struct panvk_physical_device *device,
@@ -235,7 +245,7 @@ panvk_per_arch(get_physical_device_extensions)(
 #endif
       .EXT_texel_buffer_alignment = true,
       /* ADHOC-DXVK-FL */
-      .EXT_transform_feedback = true,
+      .EXT_transform_feedback = panvk_has_gs_tess_xfb(),
       .EXT_astc_decode_mode = PAN_ARCH >= 9,
       .EXT_texture_compression_astc_hdr = true,
       .EXT_tooling_info = true,
@@ -325,8 +335,8 @@ panvk_per_arch(get_physical_device_features)(
       /* ADHOC-DXVK-FL: DXVK 1.10.3 requires geometry/tessellation features
        * for D3D_FEATURE_LEVEL >= 10_0.  Temporarily advertise them to unblock
        * the D3D11 probe.  Revert if pipeline creation asserts with GS/TCS/TES. */
-      .geometryShader = true,
-      .tessellationShader = true,
+      .geometryShader = panvk_has_gs_tess_xfb(),
+      .tessellationShader = panvk_has_gs_tess_xfb(),
       .sampleRateShading = true,
       .dualSrcBlend = true,
       .logicOp = true,
@@ -358,7 +368,7 @@ panvk_per_arch(get_physical_device_features)(
       /* ADHOC-DXVK-FL */
       .vertexPipelineStoresAndAtomics = true,
       .fragmentStoresAndAtomics = true,
-      .shaderTessellationAndGeometryPointSize = PAN_ARCH >= 10,
+      .shaderTessellationAndGeometryPointSize = panvk_has_gs_tess_xfb(),
       .shaderImageGatherExtended = true,
       .shaderStorageImageExtendedFormats = true,
       .shaderStorageImageMultisample = true,
@@ -605,8 +615,8 @@ panvk_per_arch(get_physical_device_features)(
       .inheritedConditionalRendering = PAN_ARCH >= 10,
 
       /* ADHOC-DXVK-FL: DXVK 10_0+ requires transformFeedback + geometryStreams */
-      .transformFeedback = true,
-      .geometryStreams = true,
+      .transformFeedback = panvk_has_gs_tess_xfb(),
+      .geometryStreams = panvk_has_gs_tess_xfb(),
 
       /* VK_EXT_custom_border_color */
       .customBorderColors = true,
