 }
 
+int
+kbase_kmod_jm_fence_after(struct pan_kmod_dev *dev, uint64_t dep_atom)
+{
+   struct kbase_kmod_dev *kd = container_of(dev, struct kbase_kmod_dev, base);
+   if (kd->is_csf || !dep_atom)
+      return -1;
+
+   simple_mtx_lock(&kd->atoms_lock);
+   if (!kd->fence_stream_inited) {
+      kd->fence_stream_inited = true;
+      if (!debug_get_bool_option("PANVK_JM_SYNC_FENCE", true)) {
+         kd->fence_stream_fd = -1;
+      } else {
+         struct {
+            char name[32];
+         } sc = { .name = "panvk" };
+         int sfd = ioctl(dev->fd, _IOW(KBASE_IOCTL_TYPE, 24, sc), &sc);
+         kd->fence_stream_fd = (sfd >= 0) ? sfd : -1;
+         mesa_logi("kbase: JM sync_file fence export %s (stream_fd=%d)",
+                   kd->fence_stream_fd >= 0 ? "enabled" : "unavailable",
+                   kd->fence_stream_fd);
+      }
+   }
+   int stream_fd = kd->fence_stream_fd;
+   simple_mtx_unlock(&kd->atoms_lock);
+
+   if (stream_fd < 0)
+      return -1;
+
+   struct {
+      int32_t fd;
+      int32_t stream_fd;
+   } fence = { -1, stream_fd };
+
+   uint64_t atom = kbase_kmod_job_submit_dep(
+      dev, (uintptr_t)&fence, 0x202u /* BASE_JD_REQ_SOFT_FENCE_TRIGGER */,
+      NULL, 0, dep_atom, BASE_JD_DEP_TYPE_ORDER, 0, 0, true);
+   if (!atom || fence.fd < 0)
+      return -1;
+   return fence.fd;
+}
