Subject: 0022

---
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c | 11 -----------
 src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c   |  2 ++
 src/panfrost/vulkan/panvk_cmd_draw.h         |  2 +-
 3 files changed, 3 insertions(+), 12 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 371b47d..f26af65 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -191,15 +191,10 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
        const uint8_t sample_count = render->fb.layout.sample_count;
        struct pan_fb_desc_info fbd_info = {
           .fb = &render->fb.layout,
-#if PAN_ARCH < 9
           .load = render->fb.needs_load ? &render->fb.load :
                                          &render->fb.spill.load,
           .store = render->fb.needs_store ? &render->fb.store :
                                            &render->fb.spill.store,
-#else
-          .load = &render->fb.load,
-          .store = &render->fb.store,
-#endif
           .sample_pos_array_pointer = dev->sample_positions->addr.dev +
              pan_sample_positions_offset(pan_sample_pattern(sample_count)),
           .provoking_vertex_first =
@@ -211,11 +206,7 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
        struct pan_fb_frame_shaders fs;
        VkResult result = panvk_per_arch(cmd_get_frame_shaders)(
           cmdbuf, &render->fb.layout, fbd_info.load,
-#if PAN_ARCH < 9
           render->fb.needs_store ? &render->fb.resolve : NULL, &fs);
-#else
-          &render->fb.resolve, &fs);
-#endif
       if (result != VK_SUCCESS)
          return;
 
@@ -300,9 +291,7 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
       }
 
        /* We've now done the load.  Everything from now on should spill */
-#if PAN_ARCH < 9
        cmdbuf->state.gfx.render.fb.needs_load = false;
-#endif
     }
 
    cmdbuf->cur_batch = NULL;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
index 80209e9..37f0467 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
@@ -2709,6 +2709,7 @@ panvk_per_arch(CmdBeginRendering)(VkCommandBuffer commandBuffer,
          panvk_per_arch(cmd_close_batch)(cmdbuf);
 
       panvk_per_arch(cmd_init_render_state)(cmdbuf, pRenderingInfo);
+      cmdbuf->state.gfx.render.fb.needs_load = !resuming;
    }
 
    if (!cmdbuf->cur_batch)
@@ -2722,6 +2723,7 @@ panvk_per_arch(CmdEndRendering)(VkCommandBuffer commandBuffer)
 
    if (!(cmdbuf->state.gfx.render.flags & VK_RENDERING_SUSPENDING_BIT)) {
       panvk_per_arch(cmd_alloc_fb_desc)(cmdbuf);
+      cmdbuf->state.gfx.render.fb.needs_store = true;
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       cmdbuf->cur_batch = NULL;
       panvk_per_arch(cmd_meta_resolve_attachments)(cmdbuf);
diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index 91ed427..21e6cce 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -97,9 +97,9 @@ struct panvk_rendering_state {
 #if PAN_ARCH < 9
       uint32_t bo_count;
       struct pan_kmod_bo *bos[(MAX_RTS * PANVK_MAX_PLANES) + 2];
+#endif
       bool needs_load;
       bool needs_store;
-#endif
    } fb;
 
 #if PAN_ARCH >= 10
