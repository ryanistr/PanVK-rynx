From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PanVK-rynx <panvk@local>
Date: Fri, 20 Nov 2026 04:20:00 +0700
Subject: [PATCH] panvk/v9: mirror faux123 UBO push FAU handling

---
 src/panfrost/vulkan/panvk_vX_cmd_push_constant.c | 12 ++++++++++++
 src/panfrost/vulkan/panvk_vX_shader.c            |  4 +
 2 files changed, 16 insertions(+)

--- a/src/panfrost/vulkan/panvk_vX_cmd_push_constant.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_push_constant.c
@@ -72,6 +72,15 @@
             (repeat_faus[idx] & ((uint64_t)UINT32_MAX << (32 * !hi))) |
             ((uint64_t)fau->words[i].constant << (32 * hi));
       }
+
+      /* faux123 v9 zeroes the UBO-push FAU slots (observed in its
+       * prepare_push_uniforms: str wzr). Mirror that exactly. */
+      pan_fau_foreach_reloc(fau, i) {
+         bool hi = (i & 1) != 0;
+         unsigned idx = i / 2;
+         assert(idx < shader->fau.total_count);
+         repeat_faus[idx] &= (uint64_t)UINT32_MAX << (32 * !hi);
+      }
    }
 
    return VK_SUCCESS;
--- a/src/panfrost/vulkan/panvk_vX_shader.c
+++ b/src/panfrost/vulkan/panvk_vX_shader.c
@@ -3634,6 +3634,9 @@
     * promoted constants. */
    input.fau.reserved = shader->fau.total_count * 2;
    input.fau.promote_immediates = true;
+   /* Promote constant UBO reads (e.g. light arrays) to FAU loads. The
+    * pushed FAU slots are zero-filled, matching faux123 v1.1.8's v9 path. */
+   input.fau.pushable_ubos = 0xffffffff;
 
    struct util_dynarray binary = UTIL_DYNARRAY_INIT;
    pan_shader_compile(nir, &input, &binary, &shader->info);
-- 
2.56.1
