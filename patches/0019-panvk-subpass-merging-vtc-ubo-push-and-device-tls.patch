+uint32_t
+vk_command_buffer_color_attachment_index(const struct vk_command_buffer *cmd_buffer,
+                                         uint32_t idx)
+{
+   const struct vk_render_pass *unmerged = cmd_buffer->unmerged_render_pass;
+   if (!unmerged || cmd_buffer->unmerged_subpass_idx >= unmerged->subpass_count)
+      return idx;
+
+   const struct vk_subpass *subpass =
+      &unmerged->subpasses[cmd_buffer->unmerged_subpass_idx];
+   for (uint32_t m = 0; m < subpass->cal.info.colorAttachmentCount; m++) {
+      if (subpass->cal.colors[m] == idx)
+         return m;
+   }
+   return idx;
+}
