Subject: 0020

---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h    |  9 +++++
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c | 41 ++++++++++++++++++--
 2 files changed, 46 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index b656c89..9cf982b 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -91,6 +91,15 @@ struct panvk_cmd_buffer {
     * buffer (0 = none). Reset/destroy wait for it. */
    uint64_t async_seqno;
 
+   /* Scratch backing shared by the compute-only batches of this command
+    * buffer. The queue runs them in recording order, never concurrently. */
+   struct {
+      uint64_t tls_ptr;
+      unsigned tls_size;
+      uint64_t wls_ptr;
+      unsigned wls_size;
+   } compute_scratch;
+
    struct {
       struct panvk_cmd_graphics_state gfx;
       struct panvk_cmd_compute_state compute;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index b2aac20..6ac56ea 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -111,6 +111,10 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
 
    list_addtail(&batch->node, &cmdbuf->batches);
 
+   /* Batches without a fragment job are chained one after the other, so they
+    * can share one scratch allocation instead of each taking a fresh one. */
+   const bool compute_only = !batch->fb.desc.gpu;
+
    if (batch->tlsinfo.tls.size) {
       unsigned thread_tls_alloc =
          pan_query_thread_tls_alloc(&phys_dev->kmod.dev->props);
@@ -119,14 +123,42 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
 
       unsigned size = pan_get_total_stack_size(batch->tlsinfo.tls.size,
                                                thread_tls_alloc, core_id_range);
-      batch->tlsinfo.tls.ptr =
-         panvk_cmd_alloc_dev_mem(cmdbuf, tls, size, 4096).gpu;
+      if (!compute_only) {
+         batch->tlsinfo.tls.ptr =
+            panvk_cmd_alloc_dev_mem(cmdbuf, tls, size, 4096).gpu;
+      } else {
+         if (size > cmdbuf->compute_scratch.tls_size) {
+            uint64_t ptr = panvk_cmd_alloc_dev_mem(cmdbuf, tls, size, 4096).gpu;
+            if (ptr) {
+               cmdbuf->compute_scratch.tls_ptr = ptr;
+               cmdbuf->compute_scratch.tls_size = size;
+            }
+         }
+         batch->tlsinfo.tls.ptr = size <= cmdbuf->compute_scratch.tls_size
+                                     ? cmdbuf->compute_scratch.tls_ptr
+                                     : 0;
+      }
    }
 
    if (batch->tlsinfo.wls.size) {
       assert(batch->wls_total_size);
-      batch->tlsinfo.wls.ptr =
-         panvk_cmd_alloc_dev_mem(cmdbuf, tls, batch->wls_total_size, 4096).gpu;
+      if (!compute_only) {
+         batch->tlsinfo.wls.ptr = panvk_cmd_alloc_dev_mem(
+            cmdbuf, tls, batch->wls_total_size, 4096).gpu;
+      } else {
+         if (batch->wls_total_size > cmdbuf->compute_scratch.wls_size) {
+            uint64_t ptr = panvk_cmd_alloc_dev_mem(
+               cmdbuf, tls, batch->wls_total_size, 4096).gpu;
+            if (ptr) {
+               cmdbuf->compute_scratch.wls_ptr = ptr;
+               cmdbuf->compute_scratch.wls_size = batch->wls_total_size;
+            }
+         }
+         batch->tlsinfo.wls.ptr =
+            batch->wls_total_size <= cmdbuf->compute_scratch.wls_size
+               ? cmdbuf->compute_scratch.wls_ptr
+               : 0;
+      }
    }
 
    if (batch->tls.cpu)
@@ -482,6 +514,7 @@ panvk_reset_cmdbuf(struct vk_command_buffer *vk_cmdbuf,
    panvk_pool_reset(&cmdbuf->varying_pool);
    panvk_cmd_buffer_obj_list_reset(cmdbuf, push_sets);
 
+   memset(&cmdbuf->compute_scratch, 0, sizeof(cmdbuf->compute_scratch));
    memset(&cmdbuf->state, 0, sizeof(cmdbuf->state));
 }
 
