diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 253bcd8..a234ee9 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -507,6 +507,16 @@ panvk_per_arch(CmdPipelineBarrier2)(VkCommandBuffer commandBuffer,
       if (panvk_dependency_is_noop(pDependencyInfo))
          return;
 
+#if PAN_ARCH >= 9
+      /* A by-region barrier inside a render pass only orders tilebuffer work;
+       * keeping the batch open avoids 64x tiler spill/reload round trips. */
+      if (cmdbuf->state.gfx.render.layer_count > 0 &&
+          (pDependencyInfo->dependencyFlags & VK_DEPENDENCY_BY_REGION_BIT)) {
+         cmdbuf->state.gfx.render.fb.fb_barrier = true;
+         return;
+      }
+#endif
+
       panvk_per_arch(cmd_close_batch)(cmdbuf);
       panvk_per_arch(cmd_open_batch)(cmdbuf);
    }
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_draw.c
