From 3c043f3f483b4c25ef447ced43e55166bccca9f7 Mon Sep 17 00:00:00 2001
From: ryanistr <ridho.holy@gmail.com>
Date: Thu, 19 Nov 2026 00:19:36 +0700
Subject: [PATCH] panvk/jm: distribute v9 compute tasks across cores with
 task_axis/increment

---
 src/panfrost/vulkan/jm/panvk_cmd_buffer.h     | 48 +++++++++++++++++++
 .../vulkan/jm/panvk_vX_cmd_dispatch.c         | 18 +++++--
 src/panfrost/vulkan/jm/panvk_vX_cmd_precomp.c | 11 ++++-
 3 files changed, 72 insertions(+), 5 deletions(-)

diff --git a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
index 9cf982b..b75c1bf 100644
--- a/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
+++ b/src/panfrost/vulkan/jm/panvk_cmd_buffer.h
@@ -23,9 +23,11 @@
 #include "panvk_device.h"
 #include "panvk_macros.h"
 #include "panvk_mempool.h"
+#include "panvk_physical_device.h"
 #include "panvk_shader.h"
 
 #include "pan_jc.h"
+#include "pan_props.h"
 
 #include "util/list.h"
 
@@ -166,4 +168,50 @@ void panvk_per_arch(cmd_bind_shaders)(struct vk_command_buffer *vk_cmd,
                                       const mesa_shader_stage *stages,
                                       struct vk_shader **const shaders);
 
+#if PAN_ARCH >= 9
+static inline void
+panvk_per_arch(calculate_task_axis_and_increment)(
+   const struct panvk_shader_variant *shader,
+   struct panvk_physical_device *phys_dev, const struct pan_compute_dim *wg_dim,
+   unsigned *task_axis, unsigned *task_increment)
+{
+   const struct pan_kmod_dev_props *props = &phys_dev->kmod.dev->props;
+   const unsigned max_thread_cnt =
+      pan_compute_max_thread_count(props, shader->info.work_reg_count);
+   const unsigned threads_per_wg = shader->cs.local_size.x *
+                                   shader->cs.local_size.y *
+                                   shader->cs.local_size.z;
+   const unsigned wg_count[3] = {wg_dim->x, wg_dim->y, wg_dim->z};
+   const unsigned total_wgs = wg_dim->x * wg_dim->y * wg_dim->z;
+   const unsigned total_cores = util_bitcount64(phys_dev->compute_core_mask);
+   const unsigned wgs_per_core = DIV_ROUND_UP(total_wgs, total_cores ? total_cores : 1);
+   unsigned threads_per_task;
+   unsigned wgs_per_task;
+
+   if (!total_wgs) {
+      *task_axis = MALI_TASK_AXIS_X;
+      *task_increment = 1;
+      return;
+   }
+
+   threads_per_task = DIV_ROUND_UP(max_thread_cnt, props->max_tasks_per_core);
+
+   wgs_per_task = threads_per_task / (threads_per_wg ? threads_per_wg : 1);
+   wgs_per_task = CLAMP(wgs_per_task, 1, wgs_per_core);
+
+   *task_axis = MALI_TASK_AXIS_X;
+   *task_increment = wgs_per_task;
+   for (unsigned i = 0; i < 2; i++) {
+      if (*task_increment <= wg_count[i])
+         break;
+
+      (*task_axis)++;
+      *task_increment /= wg_count[i];
+   }
+
+   assert(*task_axis <= MALI_TASK_AXIS_Z);
+   assert(*task_increment > 0);
+}
+#endif
+
 #endif
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
index 44a5701..0251a43 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_dispatch.c
@@ -239,14 +239,26 @@ cmd_dispatch(struct panvk_cmd_buffer *cmdbuf, struct panvk_dispatch_info *info)
 
    util_dynarray_append(&batch->jobs, job.cpu);
 
+    struct panvk_physical_device *phys_dev =
+       to_panvk_physical_device(cmdbuf->vk.base.device->physical);
+    unsigned task_axis = MALI_TASK_AXIS_X;
+    unsigned task_increment = 1;
+    if (indirect) {
+       task_increment = pan_calc_workgroups_per_task(
+          &cs->cs.local_size, &phys_dev->kmod.dev->props);
+    } else {
+       panvk_per_arch(calculate_task_axis_and_increment)(
+          cs, phys_dev, &wg_count, &task_axis, &task_increment);
+    }
+
     /* Pack Compute Payload using pan_section_pack for v9 */
     pan_section_pack(job.cpu, COMPUTE_JOB, PAYLOAD, cfg) {
        cfg.workgroup_size_x = cs->cs.local_size.x;
        cfg.workgroup_size_y = cs->cs.local_size.y;
        cfg.workgroup_size_z = cs->cs.local_size.z;
-       cfg.allow_merging_workgroups = false;
-       cfg.task_increment = 1;
-       cfg.task_axis = MALI_TASK_AXIS_Z;
+       cfg.allow_merging_workgroups = cs->info.cs.allow_merging_workgroups;
+       cfg.task_increment = task_increment;
+       cfg.task_axis = task_axis;
        cfg.workgroup_count_x = wg_count.x;
        cfg.workgroup_count_y = wg_count.y;
        cfg.workgroup_count_z = wg_count.z;
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_precomp.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_precomp.c
index 55ebafa..ac9ddf1 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_precomp.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_precomp.c
@@ -87,13 +87,20 @@ panvk_per_arch(dispatch_precomp)(struct panvk_precomp_ctx *ctx,
        panvk_per_arch(cmd_dispatch_prepare_tls)(cmdbuf, shader, &dim, false);
     assert(tld);
 
+    struct panvk_physical_device *phys_dev =
+       to_panvk_physical_device(cmdbuf->vk.base.device->physical);
+    unsigned task_axis = MALI_TASK_AXIS_X;
+    unsigned task_increment = 1;
+    panvk_per_arch(calculate_task_axis_and_increment)(
+       shader, phys_dev, &dim, &task_axis, &task_increment);
+
     pan_section_pack(job.cpu, COMPUTE_JOB, PAYLOAD, cfg) {
        cfg.workgroup_size_x = shader->cs.local_size.x;
        cfg.workgroup_size_y = shader->cs.local_size.y;
        cfg.workgroup_size_z = shader->cs.local_size.z;
        cfg.allow_merging_workgroups = shader->info.cs.allow_merging_workgroups;
-       cfg.task_increment = 1;
-       cfg.task_axis = MALI_TASK_AXIS_Z;
+       cfg.task_increment = task_increment;
+       cfg.task_axis = task_axis;
        cfg.workgroup_count_x = grid.count[0];
        cfg.workgroup_count_y = grid.count[1];
        cfg.workgroup_count_z = grid.count[2];
-- 
