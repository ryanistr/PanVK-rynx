       /* Disable blending for LOGICOP_NOOP unless the format is float/srgb */
       bool is_float = util_format_is_float(rt->format);
@@ -337,7 +345,6 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
