diff --git a/src/panfrost/vulkan/panvk_vX_blend.c b/src/panfrost/vulkan/panvk_vX_blend.c
index 0dc7296..1ef5c4a 100644
--- a/src/panfrost/vulkan/panvk_vX_blend.c
+++ b/src/panfrost/vulkan/panvk_vX_blend.c
@@ -326,10 +326,18 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
       if (color_attachment_formats[i] == VK_FORMAT_UNDEFINED)
          continue;
 
-      if (!cb->attachments[i].write_mask)
-         continue;
-
       rt->format = vk_format_to_pipe_format(color_attachment_formats[i]);
+      rt->nr_samples = color_attachment_samples[i];
+
+      if (!cb->attachments[i].write_mask) {
+         /* Keep the render target valid with all channel writes disabled.
+          * Skipping it leaves PIPE_FORMAT_NONE in the blend descriptor, which
+          * makes the tiler write undefined (usually black) data over contents
