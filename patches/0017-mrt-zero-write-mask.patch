          continue;
 
-      rt->nr_samples = color_attachment_samples[i];
       rt->equation.blend_enable = cb->attachments[i].blend_enable;
       rt->equation.is_float = is_float;
       rt->equation.color_mask = cb->attachments[i].write_mask;
