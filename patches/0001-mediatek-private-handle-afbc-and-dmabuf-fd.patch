diff --git a/src/util/u_gralloc/u_gralloc_fallback.c b/src/util/u_gralloc/u_gralloc_fallback.c
index 3630434..04e29e2 100644
--- a/src/util/u_gralloc/u_gralloc_fallback.c
+++ b/src/util/u_gralloc/u_gralloc_fallback.c
@@ -656,6 +656,54 @@ fallback_gralloc_get_buffer_info(struct u_gralloc *gralloc,
 
    int stable_ret = panvk_v19_query_mapper(hnd->handle, out);
    if (stable_ret != 0) {
+      if (hnd->handle->numInts >= 32 &&
+          (uint32_t)hnd->handle->data[hnd->handle->numFds + 18] == 0x03141592u) {
+         const int *ints = &hnd->handle->data[hnd->handle->numFds];
+         uint64_t af = ((uint64_t)(uint32_t)ints[31] << 32) | (uint32_t)ints[30];
+         for (int i = 0; i < hnd->handle->numFds; i++) {
+            char p[64], target[128];
+            snprintf(p, sizeof(p), "/proc/self/fd/%d", hnd->handle->data[i]);
+            ssize_t len = readlink(p, target, sizeof(target) - 1);
+            if (len > 0) {
+               target[len] = '\0';
+               if (strstr(target, "dmabuf") || strstr(target, "dma")) {
+                  out->fds[0] = hnd->handle->data[i];
+                  break;
+               }
+            }
+         }
+         if (af & (1ULL << 32)) {
+            uint64_t mod = 0;
+            if (af & (1ULL << 36)) {
+               mod |= (hnd->handle->numInts >= 43 && ints[42] == 0)
+                         ? AFBC_FORMAT_MOD_BLOCK_SIZE_32x8
+                         : AFBC_FORMAT_MOD_BLOCK_SIZE_32x8_64x4;
+            } else {
+               mod |= (af & (1ULL << 38)) ? AFBC_FORMAT_MOD_BLOCK_SIZE_64x4
+                                          : AFBC_FORMAT_MOD_BLOCK_SIZE_16x16;
+            }
+            if (af & (1ULL << 35))
+               mod |= AFBC_FORMAT_MOD_SPLIT;
+            if (af & (1ULL << 37))
+               mod |= AFBC_FORMAT_MOD_TILED;
+            if (af & (1ULL << 39))
+               mod |= AFBC_FORMAT_MOD_CBR;
+            if (af & (1ULL << 40))
+               mod |= AFBC_FORMAT_MOD_BCH;
+            if (af & (1ULL << 41))
+               mod |= AFBC_FORMAT_MOD_YTR;
+            if (af & (1ULL << 42))
+               mod |= AFBC_FORMAT_MOD_SPARSE;
+            if (af & (1ULL << 43))
+               mod |= AFBC_FORMAT_MOD_USM;
+            out->modifier = DRM_FORMAT_MOD_ARM_AFBC(mod);
+         } else if (af & (1ULL << 34)) {
+            out->modifier = DRM_FORMAT_MOD_ARM_16X16_BLOCK_U_INTERLEAVED;
+         } else {
+            out->modifier = DRM_FORMAT_MOD_LINEAR;
+         }
+         return 0;
+      }
       mesa_logw("[P0A-V19-FULLPLANE] complete metadata unavailable rc=%d; refusing guessed layout",
                 stable_ret);
       return stable_ret;
