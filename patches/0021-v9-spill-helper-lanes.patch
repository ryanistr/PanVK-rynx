Subject: 0021

---
 src/panfrost/compiler/bifrost/bi_ra.c        | 13 +++++++++----
 src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c |  7 +++++++
 2 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/src/panfrost/compiler/bifrost/bi_ra.c b/src/panfrost/compiler/bifrost/bi_ra.c
index bf1dcc5..e1d0348 100644
--- a/src/panfrost/compiler/bifrost/bi_ra.c
+++ b/src/panfrost/compiler/bifrost/bi_ra.c
@@ -713,8 +713,12 @@ bi_load_tl(bi_builder *b, unsigned bits, bi_index dst, unsigned offset)
 {
    if (b->shader->arch >= 9) {
       assert(offset < 0x8000);  /* valhall has 16 bit signed offset */
-      return bi_load_to(b, bits, dst, bi_tls_ptr(false), bi_tls_ptr(true),
-                        BI_SEG_TL, offset);
+      /* Helper lanes feed derivatives too, so spill traffic must not be
+       * dropped for them; .force is what load_scratch already uses. */
+      bi_instr *I = bi_load_to(b, bits, dst, bi_tls_ptr(false),
+                               bi_tls_ptr(true), BI_SEG_TL, offset);
+      I->mem_access = VA_MEMORY_ACCESS_FORCE;
+      return I;
    } else {
       return bi_load_to(b, bits, dst, bi_imm_u32(offset), bi_zero(), BI_SEG_TL,
                         0);
@@ -726,8 +730,9 @@ bi_store_tl(bi_builder *b, unsigned bits, bi_index src, unsigned offset)
 {
    if (b->shader->arch >= 9) {
       assert(offset < 0x8000);  /* valhall has 16 bit signed offset */
-      bi_store(b, bits, src, bi_tls_ptr(false), bi_tls_ptr(true), BI_SEG_TL,
-               offset);
+      bi_instr *I = bi_store(b, bits, src, bi_tls_ptr(false),
+                             bi_tls_ptr(true), BI_SEG_TL, offset);
+      I->mem_access = VA_MEMORY_ACCESS_FORCE;
    } else {
       bi_store(b, bits, src, bi_imm_u32(offset), bi_zero(), BI_SEG_TL, 0);
    }
diff --git a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
index 6ac56ea..371b47d 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_cmd_buffer.c
@@ -115,6 +115,13 @@ panvk_per_arch(cmd_close_batch)(struct panvk_cmd_buffer *cmdbuf)
     * can share one scratch allocation instead of each taking a fresh one. */
    const bool compute_only = !batch->fb.desc.gpu;
 
+#if PAN_ARCH == 9
+   /* The 4 KiB per-thread floor of 0012 applies to vertex and fragment
+    * shaders that spill as well, not only to compute dispatches. */
+   if (batch->tlsinfo.tls.size && batch->tlsinfo.tls.size < 4096)
+      batch->tlsinfo.tls.size = 4096;
+#endif
+
    if (batch->tlsinfo.tls.size) {
       unsigned thread_tls_alloc =
          pan_query_thread_tls_alloc(&phys_dev->kmod.dev->props);
