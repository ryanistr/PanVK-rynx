diff --git a/src/panfrost/vulkan/panvk_cmd_draw.h b/src/panfrost/vulkan/panvk_cmd_draw.h
index c1fd870..91ed427 100644
--- a/src/panfrost/vulkan/panvk_cmd_draw.h
+++ b/src/panfrost/vulkan/panvk_cmd_draw.h
@@ -499,7 +499,8 @@ panvk_per_arch(cmd_prepare_draw_sysvals)(struct panvk_cmd_buffer *cmdbuf,
 static inline uint32_t
 color_attachment_written_mask(
    const struct panvk_shader_variant *fs,
-   const struct vk_color_attachment_location_state *cal)
+   const struct vk_color_attachment_location_state *cal,
+   const struct vk_color_blend_state *cb)
 {
    uint32_t written_by_shader =
       (fs->info.outputs_written >> FRAG_RESULT_DATA0) & BITFIELD_MASK(8);
@@ -511,6 +512,12 @@ color_attachment_written_mask(
 
       uint32_t shader_rt = cal->color_map[i];
 
+      /* Zero colour write mask means the attachment is not written; leaving
+       * it in the render-target mask makes the tiler overwrite its previous
+       * contents with undefined (black) data. */
+      if (cb && cb->attachments[i].write_mask == 0)
+         continue;
+
       if (written_by_shader & BITFIELD_BIT(shader_rt))
          catt_written_mask |= BITFIELD_BIT(i);
    }
