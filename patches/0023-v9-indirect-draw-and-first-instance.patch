+KERNEL(64)
+panlib_draw_indirect_v9(
+   global uint8_t *cmd_base, uint32_t cmd_stride, uint32_t draw_count,
+   uint32_t layer_count, uint64_t index_buf_base, uint32_t index_size,
+   global uint8_t *jobs_base, uint32_t job_stride,
+   global uint8_t *vs_push_base, uint32_t vs_push_stride,
+   int32_t first_vertex_offset, int32_t base_instance_offset,
+   global uint8_t *driver_sets_base, uint32_t driver_set_stride,
+   uint32_t attribs_changing_on_base_instance,
+   global uint32_t *attrib_strides)
+{
+   uint32_t d = cl_global_id.x;
+   if (d >= draw_count)
+      return;
+
+   global const uint32_t *cmd =
+      (global const uint32_t *)(cmd_base + (uint64_t)d * cmd_stride);
+
+   uint32_t vertex_count = cmd[0];
+   uint32_t instance_count = cmd[1];
+   uint32_t first_index = index_size ? cmd[2] : 0;
+   int32_t first_vertex = index_size ? (int32_t)cmd[3] : (int32_t)cmd[2];
+   uint32_t first_instance = index_size ? cmd[4] : cmd[3];
+   bool is_no_op = (vertex_count == 0 || instance_count == 0);
+
+   struct mali_job_header_packed job_header;
+   pan_pack(&job_header, JOB_HEADER, cfg) {
+      cfg.type = is_no_op ? MALI_JOB_TYPE_NULL : MALI_JOB_TYPE_MALLOC_VERTEX;
+   }
+
+   for (uint32_t l = 0; l < layer_count; l++) {
+      global uint8_t *job =
+         jobs_base + (uint64_t)(d * layer_count + l) * job_stride;
+
+      pan_merge((global struct mali_job_header_packed *)job, &job_header,
+                JOB_HEADER);
+
+      if (is_no_op)
+         continue;
+
+      global struct mali_primitive_packed *prim =
+         (global struct mali_primitive_packed *)(job +
+                                                pan_section_offset(
+                                                   MALLOC_VERTEX_JOB,
+                                                   PRIMITIVE));
+      pan_unpack(prim, PRIMITIVE, prim_cfg);
+      pan_pack(prim, PRIMITIVE, cfg) {
+         cfg = prim_cfg;
+         cfg.base_vertex_offset = first_vertex;
+         cfg.index_count = vertex_count;
+      }
+
+      global struct mali_count_packed *inst =
+         (global struct mali_count_packed *)(job +
+                                            pan_section_offset(
+                                               MALLOC_VERTEX_JOB,
+                                               INSTANCE_COUNT));
+      pan_pack(inst, COUNT, cfg) {
+         cfg.count = instance_count;
+      }
+
+      if (index_size) {
+         global struct mali_indices_packed *indices =
+            (global struct mali_indices_packed *)(job +
+                                                 pan_section_offset(
+                                                    MALLOC_VERTEX_JOB,
+                                                    INDICES));
+         pan_pack(indices, INDICES, cfg) {
+            cfg.address = index_buf_base + (uint64_t)first_index * index_size;
+         }
+      }
+   }
+
+   if (is_no_op)
+      return;
+
+   if (vs_push_base) {
+      global uint8_t *fau = vs_push_base + (uint64_t)d * vs_push_stride;
+      if (first_vertex_offset >= 0)
+         *(global uint32_t *)(fau + first_vertex_offset) = (uint32_t)first_vertex;
+      if (base_instance_offset >= 0)
+         *(global uint32_t *)(fau + base_instance_offset) = first_instance;
+   }
+
+   if (driver_sets_base && attribs_changing_on_base_instance) {
+      global uint8_t *attribs =
+         driver_sets_base + (uint64_t)d * driver_set_stride;
+      uint32_t mask = attribs_changing_on_base_instance;
+      while (mask) {
+         uint32_t a = __builtin_ctz(mask);
+         mask &= ~(1u << a);
+         global struct mali_attribute_packed *attr =
+            (global struct mali_attribute_packed *)(attribs + a * 32);
+         pan_unpack(attr, ATTRIBUTE, attr_cfg);
+         pan_pack(attr, ATTRIBUTE, cfg) {
+            cfg = attr_cfg;
+            cfg.offset += first_instance * attrib_strides[a];
+         }
+      }
+   }
+}
+#endif
