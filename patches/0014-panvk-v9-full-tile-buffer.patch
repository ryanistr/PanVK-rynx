From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: PanVK-rynx <panvk@local>
Date: Thu, 19 Nov 2026 11:00:00 +0700
Subject: [PATCH] panvk/v9: use the full tile buffer for fill-bound render passes

---
 src/panfrost/vulkan/panvk_vX_cmd_draw.c | 20 ++++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

--- a/src/panfrost/vulkan/panvk_vX_cmd_draw.c
+++ b/src/panfrost/vulkan/panvk_vX_cmd_draw.c
@@ -17,6 +17,13 @@
 #if PAN_ARCH == 9
 #include "util/u_debug.h"
 DEBUG_GET_ONCE_OPTION(v9_rt128, "PANVK_V9_RT128", NULL)
+/* Use the whole tile buffer for one tile instead of reserving half of it for
+ * tile pipelining. On fill-bound render passes the larger tile cuts the
+ * number of tile loads/stores and the tiler work; the FBD carries the same
+ * budget so the hardware allocates a single tile. PANVK_V9_FULL_TIB=0 keeps
+ * the pipelined, half-size tiles.
+ */
+DEBUG_GET_ONCE_BOOL_OPTION(v9_full_tib, "PANVK_V9_FULL_TIB", true)
 #endif
 
 static enum pan_fb_load_op
@@ -854,8 +861,18 @@
       .rt_count = MAX2(pRenderingInfo->colorAttachmentCount, 1),
 
       .tile_rt_budget_B =
+#if PAN_ARCH == 9
+         debug_get_option_v9_full_tib()
+            ? pan_query_tib_size(phys_dev->model)
+            :
+#endif
          pan_query_optimal_tib_size(PAN_ARCH, phys_dev->model),
       .tile_z_budget_B =
+#if PAN_ARCH == 9
+         debug_get_option_v9_full_tib()
+            ? pan_query_z_tib_size(phys_dev->model)
+            :
+#endif
          pan_query_optimal_z_tib_size(PAN_ARCH, phys_dev->model),
    };
 #if PAN_ARCH == 9
-- 
