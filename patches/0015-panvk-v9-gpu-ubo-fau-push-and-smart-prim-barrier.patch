+#if PAN_ARCH == 9
+struct ubo_push_ctx {
+   struct panvk_shader_variant *shader;
+   uint32_t non_pushable_set_mask;
+   uint32_t max_words;
+};
+
+static int
+ubo_push_find_word(const struct panvk_shader_variant *shader, uint8_t set,
+                   uint16_t desc_idx, uint32_t offset)
+{
+   for (uint32_t i = 0; i < shader->fau.ubo_push.count; i++) {
+      if (shader->fau.ubo_push.entries[i].set == set &&
+          shader->fau.ubo_push.entries[i].desc_idx == desc_idx &&
+          shader->fau.ubo_push.entries[i].offset == offset)
+         return (int)i;
+   }
+   return -1;
+}
+
+static bool
+push_ubo_load_intr(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_ubo)
+      return false;
+
+   if (intr->def.bit_size != 32 || intr->num_components > 4)
+      return false;
+
+   if (!nir_src_is_const(intr->src[0]) || !nir_src_is_const(intr->src[1]))
+      return false;
+
+   struct ubo_push_ctx *ctx = data;
+   struct panvk_shader_variant *shader = ctx->shader;
+
+   const uint32_t packed = nir_src_as_uint(intr->src[0]);
+   const uint32_t table = packed >> 24;
+   const uint32_t desc_idx = packed & 0xffffff;
+   if (table < 1 || table > MAX_SETS || desc_idx > UINT16_MAX)
+      return false;
+
+   const uint8_t set = table - 1;
+   if (ctx->non_pushable_set_mask & BITFIELD_BIT(set))
+      return false;
+
+   const uint32_t offset = nir_src_as_uint(intr->src[1]);
+   if (offset & 3)
+      return false;
+
+   int slots[4];
+   uint32_t needed = 0;
+   for (unsigned c = 0; c < intr->num_components; c++) {
+      slots[c] = ubo_push_find_word(shader, set, desc_idx, offset + c * 4);
+      if (slots[c] < 0)
+         needed++;
+   }
+
+   if (shader->fau.ubo_push.count + needed > ctx->max_words)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+
+   nir_def *comps[4];
+   const uint32_t base_bytes = shader->fau.ubo_push.fau_base * FAU_WORD_SIZE;
+   for (unsigned c = 0; c < intr->num_components; c++) {
+      int slot = slots[c];
+      if (slot < 0) {
+         slot = (int)shader->fau.ubo_push.count++;
+         shader->fau.ubo_push.entries[slot].set = set;
+         shader->fau.ubo_push.entries[slot].desc_idx = desc_idx;
+         shader->fau.ubo_push.entries[slot].offset = offset + c * 4;
+      }
+      comps[c] = nir_load_push_constant(
+         b, 1, 32, nir_imm_int(b, base_bytes + (uint32_t)slot * 4),
+         .base = 0, .range = 0);
+   }
+
+   nir_def *replacement =
+      intr->num_components == 1 ? comps[0] : nir_vec(b, comps, intr->num_components);
+   nir_def_replace(&intr->def, replacement);
+   return true;
+}
+
+static void
+panvk_push_ubo_loads(nir_shader *nir,
+                     const struct panvk_shader_desc_info *desc_info,
+                     struct panvk_shader_variant *shader)
+{
+   static int mode = -1;
+   static int spare = -1;
+   if (mode < 0) {
+      const char *e = os_get_option("PANVK_UBO_PUSH");
+      mode = e ? atoi(e) : 1;
+   }
+   if (spare < 0) {
+      const char *e = os_get_option("PANVK_UBO_PUSH_SPARE");
+      spare = e ? atoi(e) : 8;
+      if (spare < 0)
+         spare = 0;
+   }
+
+   if (!(mode & 1))
+      return;
+
+   if (shader->fau.total_count + (uint32_t)spare >= FAU_WORD_COUNT)
+      return;
+
+   const uint32_t avail_pairs =
+      FAU_WORD_COUNT - (shader->fau.total_count + (uint32_t)spare);
+   struct ubo_push_ctx ctx = {
+      .shader = shader,
+      .non_pushable_set_mask = desc_info->non_pushable_set_mask,
+      .max_words = MIN2(PANVK_MAX_UBO_PUSH_WORDS, avail_pairs * 2),
+   };
+
+   shader->fau.ubo_push.fau_base = shader->fau.total_count;
+   shader->fau.ubo_push.count = 0;
+
+   NIR_PASS(_, nir, nir_shader_intrinsics_pass, push_ubo_load_intr,
+            nir_metadata_control_flow, &ctx);
+
+   if (shader->fau.ubo_push.count)
+      shader->fau.total_count += DIV_ROUND_UP(shader->fau.ubo_push.count, 2);
+}
+#endif
