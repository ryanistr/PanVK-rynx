+static void
+v9_record_ubo_push_pairs(struct panvk_cmd_buffer *cmdbuf,
+                         const struct panvk_shader_variant *shader,
+                         uint64_t fau_gpu)
+{
+   const uint32_t count = shader->fau.ubo_push.count;
+   if (!count || !fau_gpu)
+      return;
+
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+   const struct panvk_descriptor_state *desc_state = &cmdbuf->state.gfx.desc_state;
+   const uint64_t dst_base =
+      fau_gpu + (uint64_t)shader->fau.ubo_push.fau_base * sizeof(uint64_t);
+
+   for (uint32_t i = 0; i < count; i++) {
+      const uint8_t set_idx = shader->fau.ubo_push.entries[i].set;
+      const uint16_t desc_idx = shader->fau.ubo_push.entries[i].desc_idx;
+      const uint32_t offset = shader->fau.ubo_push.entries[i].offset;
+
+      if (set_idx >= MAX_SETS)
+         continue;
+      const struct panvk_descriptor_set *set = desc_state->sets[set_idx];
+      if (!set || !set->descs.host || desc_idx >= set->desc_count)
+         continue;
+
+      const struct mali_buffer_packed *packed =
+         (const struct mali_buffer_packed *)((const uint8_t *)set->descs.host +
+                                             (size_t)desc_idx * PANVK_DESCRIPTOR_SIZE);
+      pan_unpack(packed, BUFFER, buf);
+      if (buf.type != MALI_DESCRIPTOR_TYPE_BUFFER || !buf.address ||
+          (uint64_t)offset + sizeof(uint32_t) > buf.size)
+         continue;
+
+      struct panvk_ubo_push_pair pair = {
+         .src = buf.address + offset,
+         .dst = dst_base + (uint64_t)i * sizeof(uint32_t),
+      };
+      util_dynarray_append(&batch->ubo_push_pairs, pair);
+   }
+}
