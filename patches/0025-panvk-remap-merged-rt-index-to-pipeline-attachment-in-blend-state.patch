From 0c71adcaed89f08770236d3ce187d73ba796c0b6 Mon Sep 17 00:00:00 2001
From: PanVK-rynx <panvk@local>
Date: Mon, 23 Nov 2026 17:00:32 +0700
Subject: [PATCH] panvk: remap merged RT index to pipeline attachment in blend
 state

---
 src/panfrost/vulkan/panvk_vX_blend.c | 21 +++++++++++----------
 1 file changed, 11 insertions(+), 10 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_vX_blend.c b/src/panfrost/vulkan/panvk_vX_blend.c
index 99bb053..4c8036a 100644
--- a/src/panfrost/vulkan/panvk_vX_blend.c
+++ b/src/panfrost/vulkan/panvk_vX_blend.c
@@ -359,13 +359,14 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
       rt_loc[i] = loc;
       loc_rt[loc] = i;
 
-      if (!(cb->color_write_enables & BITFIELD_BIT(i)))
+      /* cb is pipeline-indexed by loc; color_attachments and bs.rts are RT-indexed by i */
+      if (!(cb->color_write_enables & BITFIELD_BIT(loc)))
          continue;
 
       if (color_attachment_formats[i] == VK_FORMAT_UNDEFINED)
          continue;
 
-      if (!cb->attachments[i].write_mask)
+      if (!cb->attachments[loc].write_mask)
          continue;
 
       rt->format = vk_format_to_pipe_format(color_attachment_formats[i]);
@@ -377,22 +378,22 @@ panvk_per_arch(blend_emit_descs)(struct panvk_cmd_buffer *cmdbuf,
          continue;
 
       rt->nr_samples = color_attachment_samples[i];
-      rt->equation.blend_enable = cb->attachments[i].blend_enable;
+      rt->equation.blend_enable = cb->attachments[loc].blend_enable;
       rt->equation.is_float = is_float;
-      rt->equation.color_mask = cb->attachments[i].write_mask;
+      rt->equation.color_mask = cb->attachments[loc].write_mask;
 
       rt->equation.rgb_func =
-         vk_blend_op_to_pipe(cb->attachments[i].color_blend_op);
+         vk_blend_op_to_pipe(cb->attachments[loc].color_blend_op);
       rt->equation.rgb_src_factor =
-         vk_blend_factor_to_pipe(cb->attachments[i].src_color_blend_factor);
+         vk_blend_factor_to_pipe(cb->attachments[loc].src_color_blend_factor);
       rt->equation.rgb_dst_factor =
-         vk_blend_factor_to_pipe(cb->attachments[i].dst_color_blend_factor);
+         vk_blend_factor_to_pipe(cb->attachments[loc].dst_color_blend_factor);
       rt->equation.alpha_func =
-         vk_blend_op_to_pipe(cb->attachments[i].alpha_blend_op);
+         vk_blend_op_to_pipe(cb->attachments[loc].alpha_blend_op);
       rt->equation.alpha_src_factor =
-         vk_blend_factor_to_pipe(cb->attachments[i].src_alpha_blend_factor);
+         vk_blend_factor_to_pipe(cb->attachments[loc].src_alpha_blend_factor);
       rt->equation.alpha_dst_factor =
-         vk_blend_factor_to_pipe(cb->attachments[i].dst_alpha_blend_factor);
+         vk_blend_factor_to_pipe(cb->attachments[loc].dst_alpha_blend_factor);
 
       /* We have the format and the constants so we can optimize the blend
        * equation before we decide if we actually need a blend shader.
-- 
