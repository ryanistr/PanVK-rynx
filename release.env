# PanVK-rynx source and release pin.
# The source tree is a read-only third-party fork; this repository keeps the patches that
# make it usable on a Mali-G77 (MT6893) and publishes the resulting driver.
PANVK_SOURCE_REPO=https://github.com/apexspan-svg/mesa-panvk-mali-g57.git
PANVK_SOURCE_TAG=v1.2.0

# Recommended release. p7 adds the Mali-G77 model row (0009) and the widened swapchain BO
# dump (0010) to p6's CSF fixes. The bytes are unchanged from the asset previously hosted
# in ryanistr/DroidDeck-Mali; only the release's home moves.
PANVK_RELEASE_TAG=PanVK-rynx-1.2.0-p7
PANVK_RELEASE_SHA256=85a6935490d00876925945404cf6135bad3cf1d640c3fa96d8217df252b798c3

# To publish the next patch:
#   gh workflow run release.yml -R ryanistr/PanVK-rynx -f version=1.2.0 -f tag=PanVK-rynx-1.2.0-p8
# then set PANVK_RELEASE_TAG/PANVK_RELEASE_SHA256 above and update the consumer's pin.
