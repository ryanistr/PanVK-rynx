# PanVK-rynx source and release pin.
# The source tree is a read-only third-party fork; this repository keeps the patches that
# make it usable on a Mali-G77 (MT6893) and publishes the resulting driver.
PANVK_SOURCE_REPO=https://github.com/apexspan-svg/mesa-panvk-mali-g57.git
PANVK_SOURCE_TAG=v1.2.0

# Recommended release. p8 is built from this repository with patches 0001-0014 (the
# perf-knob property A/B aid); p7 remains available as the unmodified prior asset.
PANVK_RELEASE_TAG=PanVK-rynx-1.2.0-p8
PANVK_RELEASE_SHA256=5b659e75629c94d2ea22b73d135a795a8c08b799859046b1d6012c201314ea81

# To publish the next patch:
#   gh workflow run release.yml -R ryanistr/PanVK-rynx -f version=1.2.0 -f tag=PanVK-rynx-1.2.0-p9
# then set PANVK_RELEASE_TAG/PANVK_RELEASE_SHA256 above and update the consumer's pin.
